# Only needed for the VLM high-level planner (scripts/plan_task.py).
# The MuJoCo sim, teleop, scripted expert, and data recording need none of this.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: needed for gated/private Hugging Face models or higher API limits.
# Public models such as lerobot/smolvla_base usually do not need a token.
HF_TOKEN=hf_...
